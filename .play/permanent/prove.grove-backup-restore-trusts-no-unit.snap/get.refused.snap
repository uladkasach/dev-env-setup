🥥 restore, as the row's seat, from this repo's checkout (cd ~/git/more/dev-env-setup)
   ├─ org=<o>/repo=<r>/tree=<t>       rhx grove.backup.restore --from grove-1 --of <o>/<r> --tree <t>
   ├─ org=<o>/orphan=<d>              rhx grove.backup.restore --from grove-1 --orphan <o>/<d>
   ├─ org=<o>/repo=<r>/setaside=<s>   rhx grove.backup.restore --from grove-1 --of <o>/<r> --setaside <s>
   ├─ home=<h>                        rhx grove.backup.restore --from grove-1 --home <h>
   └─ every unit of the seat          rhx grove.backup.restore --from grove-1 --all
