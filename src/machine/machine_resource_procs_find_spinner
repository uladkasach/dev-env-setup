#!/bin/bash
#############################
# machine_resource_procs_find_spinner
# finds long-lived processes whose cpu-time / elapsed-time ratio clears a
# sustained-burn gate
#############################

KILL_MODE=""
MIN_ELAPSED=1800  # 30 minutes in seconds

# .what = the cpu-time / elapsed-time ratio above which a long-lived process
#         counts as a spinner
#
# .why  = 50 was too high and left a blind spot. a wedged `npm exec depcheck`
#         held ~24% of a core for 145 HOURS and this detector reported "none
#         caught" the whole time — its ratio never reached 50.
#
#         a stuck process rarely pegs a full core. it polls, retries, or spins
#         on a partial wait, so it lands in the teens or twenties. meanwhile
#         the runaway detector only fires when SYSTEM load crosses cores*1.5,
#         and then ranks by instantaneous %CPU — which surfaces the 1-second-old
#         node processes that happen to be at 150% and buries the 6-day
#         offender at 24%. so neither detector could see it.
#
#         15% sustained across 30+ minutes is not normal work; a real task
#         either finishes or varies. this is the sustained-burn gate, and the
#         MIN_ELAPSED gate above is what keeps honest work out of the net.
MIN_RATIO=15

# .what = seconds of live cpu sampled per candidate; see pass 2 below
WINDOW=3

while [[ $# -gt 0 ]]; do
  case "$1" in
    --kill)
      KILL_MODE="all"
      if [[ -n "$2" && "$2" != --* ]]; then
        KILL_MODE="$2"
        shift
      fi
      shift
      ;;
    --min-minutes)
      MIN_ELAPSED=$(( $2 * 60 ))
      shift 2
      ;;
    --min-ratio)
      MIN_RATIO="$2"
      shift 2
      ;;
    --window)
      WINDOW="$2"
      shift 2
      ;;
    *)
      echo "Usage: machine_resource_procs_find_spinner [--kill [<prefix>]] [--min-minutes N] [--min-ratio N] [--window SECONDS]" >&2
      exit 1
      ;;
  esac
done

[[ "$WINDOW" =~ ^[1-9][0-9]*$ ]] || {
  echo "✋ ConstraintError: --window must be a whole number of seconds >= 1, got '$WINDOW'" >&2
  exit 2
}

SPINNER_PIDS=""
SPINNER_INFO=""
HOST_INFO=""
QUIET_INFO=""

# .what = hosts: processes that CONTAIN other work, so a high burn ratio is the
#         sum of their tenants, never a wedge of their own
#
# .why  = this report printed `🪄 kill -9 19210` for the tmux server
#         (57% over 7.8 days). that server relays every pane's output — 35
#         claude TUIs redraw through it — and a kill ends every session at
#         once. machine.diagnose.churn holds hosts out of its blame list for
#         the identical reason (2026-09-05). a host is reported, never offered
#         as a kill target, and `--kill` never reaches one
__is_host() {
  case "$1" in
    "tmux: server"|kitty|cosmic-comp|Xwayland|gnome-shell|systemd|pipewire|wireplumber) return 0 ;;
    *) return 1 ;;
  esac
}

# .what = a process's cpu ticks (utime + stime) from /proc/<pid>/stat
# .note = comm sits in parens and may hold spaces, so the fields are read
#         after the LAST `) `; utime and stime are then fields 12 and 13
__ticks() {
  local stat
  stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  stat=${stat##*) }
  # shellcheck disable=SC2086
  set -- $stat
  echo $(( ${12} + ${13} ))
}

# pass 1: the lifetime ratio, a cheap prefilter over every user process
CAND_PIDS=()
declare -A CAND_LINE CAND_COMM CAND_T0
while read -r pid etimes cputimes comm; do
  [[ -z "$pid" ]] && continue
  [[ "$etimes" -lt "$MIN_ELAPSED" ]] && continue

  # calculate ratio (percentage)
  if [[ "$etimes" -gt 0 ]]; then
    ratio=$(( (cputimes * 100) / etimes ))
  else
    ratio=0
  fi

  if [[ "$ratio" -ge "$MIN_RATIO" ]]; then
    CAND_PIDS+=("$pid")
    CAND_COMM[$pid]="$comm"
    CAND_LINE[$pid]="$pid ($comm): ${ratio}% CPU over $(( etimes / 60 ))m ($(( cputimes / 60 ))m CPU time)"
  fi
done < <(ps -u "$USER" -o pid=,etimes=,cputimes=,comm=,args= 2>/dev/null | awk '{ c = $4; if ($4 == "tmux:" && $5 == "server") c = "tmux: server"; print $1, $2, $3, c }')

# pass 2: the burn NOW, over a live window
#
# .why  = the lifetime ratio is an average since birth, so it cannot tell a
#         process that spins now from one that spun days ago and is quiet.
#         the tmux server read `48% CPU over 14498m` while it drew 8% of a
#         core (2026-10-21): the 48 was a week of history. a spinner is a
#         SUSTAINED burn, so it must clear the gate on both clocks — the
#         lifetime ratio says it has burned long, the window says it still does
HZ=$(getconf CLK_TCK 2>/dev/null || echo 100)
for pid in "${CAND_PIDS[@]}"; do
  CAND_T0[$pid]=$(__ticks "$pid" || echo "")
done
(( ${#CAND_PIDS[@]} > 0 )) && sleep "$WINDOW"
for pid in "${CAND_PIDS[@]}"; do
  t0="${CAND_T0[$pid]}"
  t1=$(__ticks "$pid" || echo "")
  [[ -z "$t0" || -z "$t1" ]] && continue  # exited within the window
  now=$(( (t1 - t0) * 100 / (HZ * WINDOW) ))
  line="${CAND_LINE[$pid]}, ${now}% over the last ${WINDOW}s"
  if __is_host "${CAND_COMM[$pid]}"; then
    HOST_INFO+="$line\n"
    continue
  fi
  if [[ "$now" -lt "$MIN_RATIO" ]]; then
    QUIET_INFO+="$line\n"
    continue
  fi
  SPINNER_PIDS+="$pid "
  SPINNER_INFO+="$line\n"
done

echo "🐈 lets prowl..."
echo "└─🌕 spinner"

# hosts first, marked, with no kill hint
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  echo "  ├─🏠 $line"
  echo "  │   ↳ host — its burn is the sum of its tenants; a kill ends them all, not the burn"
done <<< "$(echo -e "$HOST_INFO")"

# burned long, but quiet now: history, not a spinner — shown, never killed
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  echo "  ├─💤 $line"
  echo "  │   ↳ quiet now — the lifetime ratio is history, not a live burn"
done <<< "$(echo -e "$QUIET_INFO")"

if [[ -z "$SPINNER_PIDS" ]]; then
  echo "  └─✨ none caught"
  exit 0
fi

# format as tree entries
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  echo "  ├─🦎 $line"
done <<< "$(echo -e "$SPINNER_INFO")"
echo "  └─🪄 kill -9 $SPINNER_PIDS"

if [[ -n "$KILL_MODE" ]]; then
  echo ""
  if [[ "$KILL_MODE" == "all" ]]; then
    echo "Kill all spinner processes..."
    kill -9 $SPINNER_PIDS 2>/dev/null
  else
    # filter by prefix
    FILTERED_PIDS=""
    for pid in $SPINNER_PIDS; do
      comm=$(cat /proc/$pid/comm 2>/dev/null || echo "")
      if [[ "$comm" == *"$KILL_MODE"* ]]; then
        FILTERED_PIDS+="$pid "
      fi
    done
    if [[ -z "$FILTERED_PIDS" ]]; then
      echo "No spinner processes matching '$KILL_MODE'"
    else
      echo "Kill spinner processes matching '$KILL_MODE': $FILTERED_PIDS"
      kill -9 $FILTERED_PIDS 2>/dev/null
    fi
  fi
  echo "Done."
fi
